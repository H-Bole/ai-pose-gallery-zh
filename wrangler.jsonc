{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "h-bole-ai-pose-gallery",
  "main": "worker.ts",
  "compatibility_date": "2025-10-01",
  "observability": {
    "enabled": true
  },
  "previews": {},
  "workers_dev": true,
  "routes": [{ "pattern": "pose.boledev.dpdns.org", "custom_domain": true }],
  // 可选环境变量：通过 Cloudflare 控制台为本 Worker 配置 PROXY_ALLOWED_ORIGINS。
  // 或在 Cloudflare 控制台 Variables and Secrets 中配置 PROXY_ALLOWED_ORIGINS（支持逗号分隔的精确域名或 https://*.openai.com 泛子域名）
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
